{
   "action": {
      "default_icon": {
         "128": "icons/icon128.png",
         "16": "icons/icon16.png",
         "48": "icons/icon48.png"
      },
      "default_popup": "popup.html"
   },
   "background": {
      "service_worker": "background.js"
   },
   "commands": {
      "toggle-game": {
         "description": "Launch or remove BlastBlastBlast on the current page",
         "suggested_key": {
            "default": "Alt+Shift+X"
         }
      }
   },
   "content_scripts": [  ],
   "description": "Blast any webpage to pieces! Fire cannons, rockets, flamethrowers and lasers at soldiers and enemy tanks. Pure chaos, pure fun.",
   "icons": {
      "128": "icons/icon128.png",
      "16": "icons/icon16.png",
      "48": "icons/icon48.png"
   },
   "manifest_version": 3,
   "name": "BlastBlastBlast",
   "permissions": [ "scripting", "activeTab", "storage" ],
   "version": "1.5.0"
}
